<li class="article-item">
    <a href="{{url}}" target="_blank" rel="noopener noreferrer">
        <article class="article-card">
            <img
                src="{{urlToImage}}"
                alt="{{title}}"
                width="480"
            >
            <h2>{{title}}</h2>
            <p>Posted by: {{author}}</p>
            <p>{{description}}</p>
        </article>
    </a>
</li>